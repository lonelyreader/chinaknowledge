{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run env:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "env:check": "tsx scripts/check-environment.ts",
    "payload": "payload",
    "cms:db:up": "docker compose up -d cms-db",
    "cms:db:stop": "docker compose stop cms-db",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migration:create": "payload migrate:create",
    "cms:migration:run": "payload migrate",
    "cms:migration:status": "payload migrate:status",
    "cms:bootstrap-super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "cms:provision-core-taxonomies": "tsx scripts/provision-core-taxonomies.ts",
    "cms:rebind-cold-start-release": "tsx scripts/rebind-cold-start-release-manifests.ts",
    "cms:provision-accounts": "tsx scripts/provision-cms-accounts.ts",
    "cms:retry-notifications": "tsx scripts/retry-editorial-notifications.ts",
    "cms:import-cold-start": "tsx scripts/import-cold-start-content.ts",
    "cms:build-cold-start-review": "tsx scripts/build-cold-start-review-manifest.ts",
    "cms:apply-cold-start-review": "tsx scripts/apply-cold-start-review-decisions.ts",
    "cms:build-cold-start-translations": "tsx scripts/build-cold-start-translation-template.ts",
    "cms:import-cold-start-translations": "tsx scripts/import-cold-start-translations.ts",
    "test:editorial": "tsx tests/editorial-workflow.ts",
    "test:cold-start-translations": "tsx tests/cold-start-translations.ts",
    "test:environment": "tsx tests/environment.ts",
    "test:migration-recovery": "node scripts/test-migration-recovery.mjs",
    "test:media-upload-filename": "tsx tests/media-upload-filename.ts",
    "test:newsletter": "tsx tests/newsletter.ts && tsx tests/newsletter-route.ts",
    "test:preview-config": "tsx tests/preview-config.ts",
    "test:password-reset": "tsx tests/password-reset.ts",
    "test:agent": "tsx tests/agent-contracts.ts && tsx tests/agent-http.ts && tsx tests/agent-routes.ts && tsx tests/agent-fixtures.ts && tsx tests/agent-oauth-model.ts && tsx tests/agent-schema.ts",
    "test:agent:live": "tsx tests/agent-live.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@node-oauth/oauth2-server": "5.3.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-resend": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "next": "16.2.12",
    "payload": "3.86.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "2.3.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
